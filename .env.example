# Hugging Face token for voice cloning (optional)
# Get your token from: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxx

# Local environment configuration template
# Copy to .env and customize as needed

# Server settings
POCKET_TTS_PORT=49112
POCKET_TTS_STREAM_DEFAULT=true
POCKET_TTS_NORMALIZE_DEFAULT=false
POCKET_TTS_SEGMENTATION_DEFAULT=none

# Request hardening / security (all optional — defaults keep existing behavior)
# Reject synthesis input longer than this many characters (0 disables the cap).
# POCKET_TTS_MAX_INPUT_CHARS=32000
# Optional bearer token. When set, every route except /health and /ready requires
# `Authorization: Bearer <key>`. Leave unset for open local use.
# POCKET_TTS_API_KEY=change-me
# Silence inserted between synthesized segments in ms (0 disables the gap).
# POCKET_TTS_SEGMENT_GAP_MS=200
# Bound for the loaded-voice LRU cache (0 = unbounded).
# POCKET_TTS_MAX_CACHED_VOICES=8
# Waitress worker threads (only used by `python server.py`, not the container path).
# POCKET_TTS_THREADS=4

# Optional: briefing profile for long transcript-style inputs.
# When enabled, defaults become normalize=true + segmentation=sentence.
# Also enables source-links stripping unless overridden.
# POCKET_TTS_BRIEFING_MODE=true
# POCKET_TTS_DROP_SOURCE_LINKS=true

# Optional: custom voices directory
# POCKET_TTS_VOICES_DIR=./voices

# Optional: default voice id or filename
# If ./voices/default.wav exists, default voice is default.wav automatically.
# POCKET_TTS_DEFAULT_VOICE=default.wav
# Optional: when clients send unknown voice IDs (e.g. "zoe"), fall back
# to POCKET_TTS_DEFAULT_VOICE instead of returning 400.
POCKET_TTS_FALLBACK_UNKNOWN_VOICE=true

# Optional: local cache/download directory for PocketTTS + Hugging Face artifacts.
# Pre-populate it (e.g. `hf download kyutai/pocket-tts --local-dir ...`) and the
# server loads weights from disk without hitting HuggingFace at startup.
# NOTE: when running via docker-compose this is overridden to /data/models/pocket-tts
# by deploy/docker-compose.yml (container-internal path). The value below applies to
# local (non-Docker) runs and defaults to ./data/... relative to the repo root.
POCKET_TTS_MODEL_CACHE_DIR=./data/models/pocket-tts

# Optional: fail startup if voice-cloning weights are not loaded
# (instead of silently falling back to without-voice-cloning)
# POCKET_TTS_REQUIRE_VOICE_CLONING=true

# Logging. stdout is always on and, under Docker, captured by the container log
# driver (rotated via deploy/docker-compose.yml). Set LOG_TO_FILE=true to also
# write a rotating file at $POCKET_TTS_LOG_DIR/pocket_tts.log — but note there is
# no /data/logs volume by default, so enable it only if you add that mount.
POCKET_TTS_LOG_LEVEL=INFO
# POCKET_TTS_LOG_TO_FILE=false

# HF token for the container: deploy/docker-compose.yml mounts a host file at
# /run/secrets/hf_token and sets HF_TOKEN_FILE to point at it. Override the host
# path by exporting HF_TOKEN_FILE=<path> before running docker compose (or put it
# in deploy/.env). For local runs you can instead set HF_TOKEN directly:
# HF_TOKEN=hf_...
