# Hugging Face token for voice cloning (optional)
# Get your token from: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxx

# Local environment configuration template
# Copy to .env and customize as needed

# Server settings
POCKET_TTS_PORT=49112
POCKET_TTS_LOG_LEVEL=INFO
POCKET_TTS_STREAM_DEFAULT=true
POCKET_TTS_NORMALIZE_DEFAULT=false
POCKET_TTS_SEGMENTATION_DEFAULT=none

# Optional: briefing profile for long transcript-style inputs.
# When enabled, defaults become normalize=true + segmentation=sentence.
# Also enables source-links stripping unless overridden.
# POCKET_TTS_BRIEFING_MODE=true
# POCKET_TTS_DROP_SOURCE_LINKS=true

# Optional: custom voices directory
# POCKET_TTS_VOICES_DIR=./voices

# Optional: default voice id or filename
# If ./voices/default.wav exists, default voice is default.wav automatically.
# POCKET_TTS_DEFAULT_VOICE=default.wav
# Optional: when clients send unknown voice IDs (e.g. "zoe"), fall back
# to POCKET_TTS_DEFAULT_VOICE instead of returning 400.
POCKET_TTS_FALLBACK_UNKNOWN_VOICE=true

# Optional: local cache/download directory for PocketTTS + Hugging Face artifacts
POCKET_TTS_MODEL_CACHE_DIR=./data/models/pocket-tts
# Optional: direct local-dir repo path (e.g. ./models/kyutai/pocket-tts)
POCKET_TTS_LOCAL_MODEL_DIR=./data/models/kyutai/pocket-tts
# Optional: prefer locally-downloaded cloning snapshots in MODEL_CACHE_DIR
POCKET_TTS_PREFER_LOCAL_CLONING_MODEL=true

# Optional: fail startup if voice-cloning weights are not loaded
# (instead of silently falling back to without-voice-cloning)
# POCKET_TTS_REQUIRE_VOICE_CLONING=true

# Host bind-mount directories used by docker-compose
POCKET_TTS_HOST_MODELS_DIR=/mnt/RAID0/WORKSPACES/data/models
POCKET_TTS_HOST_VOICES_DIR=/mnt/RAID0/WORKSPACES/data/voices
POCKET_TTS_HOST_LOGS_DIR=/mnt/RAID0/WORKSPACES/data/logs
